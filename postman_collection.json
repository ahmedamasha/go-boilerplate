        },
        {
          "name": "Get Event By ID (hide amounts)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}?hide_amounts=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events", "{{eventId}}"],
              "query": [{ "key": "hide_amounts", "value": "true" }]
            },
            "description": "Omits amount_received on gifts when hide_amounts=true"
          }
        },
        {
          "name": "Withdraw (Partial)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('partial withdrawal', () => {",
                  "  pm.expect(j.success).to.eql(true);",
                  "  pm.expect(j.data.event_status).to.eql('partial_withdrawn');",
                  "});",
                  "if (j.data && j.data.withdrawal_id) {",
                  "  pm.collectionVariables.set('withdrawalId', j.data.withdrawal_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 400\n}",
              "options": { "raw": { "language": "json" } }
            },
