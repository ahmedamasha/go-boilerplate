            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}?hide_amounts=false",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events", "{{eventId}}"],
              "query": [{ "key": "hide_amounts", "value": "false" }]
