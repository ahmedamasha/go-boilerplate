            "description": "Owner only. Event must be `collected` (100% target reached).\n\nWithdraws up to `amount_available`. Status becomes `partial_withdrawn` or `fully_withdrawn`."
          }
        },
        {
          "name": "Withdraw (Full Remainder)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
