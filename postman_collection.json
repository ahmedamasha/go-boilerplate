              "raw": "{\n  \"amount\": 600\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/events/{{eventId}}/withdraw",
            "description": "Withdraw remaining balance after partial withdrawal (400 + 600 = 1000 target)."
          }
        }
      ]
    },
