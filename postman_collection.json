    {
      "name": "Events",
      "item": [
        {
          "name": "Create Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('event created pending_review', () => {",
                  "  pm.expect(j.success).to.eql(true);",
                  "  pm.expect(j.data.status).to.eql('pending_review');",
                  "  pm.expect(j.data.gifts.length).to.be.above(0);",
                  "});",
                  "if (j.data) {",
                  "  pm.collectionVariables.set('eventId', j.data.id);",
                  "  const product = j.data.gifts.find(g => g.type === 'product');",
                  "  const cash = j.data.gifts.find(g => g.type === 'cash');",
                  "  if (product) pm.collectionVariables.set('giftId', product.id);",
                  "  if (cash) pm.collectionVariables.set('giftCashId', cash.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"حفل زفاف أحمد وفاطمة\",\n  \"event_type\": \"wedding\",\n  \"event_date\": \"2026-08-15\",\n  \"event_time\": \"19:00\",\n  \"target_amount\": 1000,\n  \"privacy\": \"public\",\n  \"gifts\": [\n    {\n      \"name\": \"طقم ذهب\",\n      \"type\": \"product\",\n      \"target_amount\": 800,\n      \"image_urls\": []\n    },\n    {\n      \"name\": \"مساهمة نقدية\",\n      \"type\": \"cash\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/events",
            "description": "Creates event with status `pending_review`. Admin must approve before contributions.\n\nevent_type: wedding | newborn | birthday | other\nprivacy: public | private\ngift type: product | cash\nevent_date: YYYY-MM-DD or ISO 8601"
          }
        },
